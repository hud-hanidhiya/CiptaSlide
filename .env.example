# CiptaSlide — konfigurasi LLM provider (OpenAI-compatible).
# Salin file ini jadi `.env` lalu isi nilainya. JANGAN commit .env.
#
# CATATAN: variabel di bawah ini HANYA dibutuhkan untuk jalur chat (brief -> PPTX).
# Jalur HTML -> PPTX (UI di /html/ dan API /api/v1/*) tidak membaca .env sama
# sekali, jadi semua variabel ini boleh kosong kalau Anda hanya pakai konverter HTML.

# Base URL provider LLM (OpenAI-compatible /chat/completions).
# Contoh:
#   OpenAI   : https://api.openai.com/v1
#   DeepSeek : https://api.deepseek.com/v1
#   Ollama   : http://127.0.0.1:11434/v1
API_BASE_URL=https://openrouter.ai/api/v1

# API key provider (server-side saja, tidak pernah dikirim ke browser)
API_KEY=

# Nama model, mis. gpt-4o-mini / deepseek-chat / llama3.1
MODEL_NAME=

# Port server lokal (opsional, default 3000). Host SELALU 127.0.0.1 (hardcoded).
PORT=3002

# Timeout request ke LLM dalam ms (opsional, default 120000) — provider lokal bisa lambat
LLM_TIMEOUT_MS=120000

# Batas max_tokens per request LLM (opsional, default 8192) — guardrail biaya
LLM_MAX_TOKENS=8192

# Batas panjang pesan chat dari operator dalam karakter (opsional, default 8000)
MAX_MESSAGE_CHARS=8000

# Kalau false, server tetap jalan TANPA LLM: hanya konverter HTML -> PPTX yang aktif.
# Default true (fail-fast) supaya salah konfigurasi ketahuan sejak awal.
LLM_REQUIRED=true
