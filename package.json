{
  "name": "ciptaslide",
  "version": "0.1.0",
  "private": true,
  "description": "CiptaSlide - konverter HTML/CSS ke PPTX yang editable + AI PPTX generator (web app lokal)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node dist/server/app.js",
    "dev": "npm run build && node --watch dist/server/app.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "openai": "^4.77.0",
    "parse5": "^7.3.0",
    "pptxgenjs": "^3.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
